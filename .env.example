NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANDROID_APK_URL=
ANDROID_LATEST_VERSION=1.3.1
ANDROID_MINIMUM_VERSION=1.2.1

# Auth.js / Google OAuth
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL / Supabase
DATABASE_URL=
DIRECT_URL=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fotos-alunos

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel AI Gateway (opcional localmente; em produção a Vercel injeta VERCEL_OIDC_TOKEN)
AI_GATEWAY_API_KEY=

# Google AI Studio (fallback gratuito para relatorios e transcricao de audio)
GEMINI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_UPGRADE_URL=https://planejei.com/upgrade

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Cron security
CRON_SECRET=
