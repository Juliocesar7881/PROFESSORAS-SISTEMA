{
  "expo": {
    "name": "Pequenos Passos",
    "slug": "planejei-registros",
    "owner": "loops7881",
    "version": "1.3.1",
    "orientation": "portrait",
    "scheme": "planejei",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbfaf8",
    "android": {
      "package": "br.com.planejei.registros",
      "versionCode": 19,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#fbfaf8",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#fbfaf8"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita que o Pequenos Passos transcreva seus registros de voz.",
          "speechRecognitionPermission": "Permita que o Pequenos Passos transforme sua fala em registros pedagogicos.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita anexar fotos aos registros pedagogicos.",
          "cameraPermission": "Permita fotografar evidencias pedagogicas."
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://professoras-sistema-main.vercel.app",
      "eas": {
        "projectId": "4f7f1028-9524-4d3f-81f1-c7d2cf87a179"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/4f7f1028-9524-4d3f-81f1-c7d2cf87a179"
    },
    "ios": {
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permita que o Pequenos Passos transforme sua fala em registros pedagogicos.",
        "NSMicrophoneUsageDescription": "Permita que o Pequenos Passos transcreva seus registros de voz."
      }
    }
  }
}
